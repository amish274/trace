<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>MonitorAgent</AssemblyName>
    <RootNamespace>MonitorAgent</RootNamespace>
    <AssemblyTitle>TeamTrace Workplace Agent</AssemblyTitle>
    <Product>TeamTrace Employee Monitoring</Product>
    <Description>TeamTrace Background Employee Monitoring Client</Description>
    <Company>TeamTrace Software</Company>
    <Copyright>Copyright © TeamTrace Software. All rights reserved.</Copyright>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

</Project>
