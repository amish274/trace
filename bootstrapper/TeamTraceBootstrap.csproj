<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>TeamTraceBootstrap</RootNamespace>
    <AssemblyName>TeamTraceBootstrap</AssemblyName>
    <AssemblyTitle>TeamTrace Installer Bootstrapper</AssemblyTitle>
    <Product>TeamTrace Employee Monitoring</Product>
    <Description>TeamTrace Workplace Activity Monitoring Installer</Description>
    <Company>TeamTrace Software</Company>
    <Copyright>Copyright © TeamTrace Software. All rights reserved.</Copyright>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

</Project>
